{
  "name": "rezayi-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "biome lint .",
    "typecheck": "next typegen && tsc --noEmit",
    "api:generate": "openapi-typescript ../backend/schema.json -o lib/api/schema.d.ts",
    "test": "node --experimental-strip-types --test tests/api.test.ts tests/auth.test.ts tests/organizations.test.ts tests/site.test.ts tests/catalogue.test.ts tests/inventory.test.ts tests/auth-routes.test.ts tests/marketplace.test.ts tests/messaging.test.ts tests/commerce.test.ts tests/negotiations.test.ts tests/payments.test.ts tests/fulfilment.test.ts tests/aftercare-validation.test.ts tests/aftercare-draft.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
