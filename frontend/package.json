{
  "name": "rezayi-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "biome lint .",
    "typecheck": "next typegen && tsc --noEmit",
    "api:generate": "openapi-typescript ../backend/schema.json -o lib/api/schema.d.ts",
    "test": "node --experimental-strip-types --test tests/api.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
