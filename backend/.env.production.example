DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-generated-production-secret
DJANGO_ALLOWED_HOSTS=api.bazartejaratrezayi.com
DJANGO_CORS_ALLOWED_ORIGINS=https://bazartejaratrezayi.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://bazartejaratrezayi.com
DJANGO_SECURE_HSTS_SECONDS=0
POSTGRES_DB=replace-with-production-database
POSTGRES_USER=replace-with-production-user
POSTGRES_PASSWORD=replace-with-production-password
POSTGRES_HOST=replace-with-production-host
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
CELERY_BROKER_URL=rediss://:replace-with-production-password@replace-with-production-redis-host:6379/0?ssl_cert_reqs=required
