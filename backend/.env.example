# -------------------------------------------------------------------------------------------
# PRIVATE APPLICATION SECRETS
# -------------------------------------------------------------------------------------------
DJANGO_SECRET_KEY='replace-with-a-private-random-signing-secret-at-least-50-characters'
MFA_ENCRYPTION_KEY='replace-with-your-existing-private-fernet-key'

# -------------------------------------------------------------------------------------------
# DEVELOMENT OWNER SIGHN-IN ONLY
# -------------------------------------------------------------------------------------------
OWNER_MFA_REQUIRED=false

# -------------------------------------------------------------------------------------------
# APPLICATION POSTGRE-SQL CONNECTION
# -------------------------------------------------------------------------------------------
DATABASE_URL='postgresql://replace-app-user:replace-password@127.0.0.1:5432/replace-database'
DATABASE_HOST=host.docker.internal

# -------------------------------------------------------------------------------------------
# REDIS SERVER AND BROKER URL APPLICATION SECRETS
# -------------------------------------------------------------------------------------------
REDIS_PASSWORD='replace-with-a-private-redis-password'
CELERY_BROKER_URL='redis://:replace-with-a-private-redis-password@redis:6379/0'

# -------------------------------------------------------------------------------------------
# TRUSTED LOCAL APPLICATION HOSTS/ORIGINS.
# -------------------------------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:3100
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100

# -------------------------------------------------------------------------------------------
# OPTIONAL GOOGLE LOGIN
# -------------------------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_REDIRECT_URI=http://127.0.0.1:8100/api/v1/auth/google/callback/


# -------------------------------------------------------------------------------------------
# LOCAL CAPTURE SENDS NO REAL MAIL. PRODUCTION REQUIRES INTENTIONAL SMTP CONFIGURATION.
# -------------------------------------------------------------------------------------------
ACCOUNT_EMAIL_TRANSPORT=capture

# -------------------------------------------------------------------------------------------
# SMTP DEFAULTS
# -------------------------------------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''
EMAIL_TIMEOUT=10

# -------------------------------------------------------------------------------------------
# OPTIONAL GROQ DRAFT TRANSLATIONS.
# -------------------------------------------------------------------------------------------
CATALOGUE_TRANSLATION_ENABLED=false
GROQ_API_KEY=''
GROQ_MODEL=''
# Positive daily ceilings required for activation; 0 disables external generation.
GROQ_DAILY_CALL_LIMIT=0
GROQ_DAILY_CHARACTER_LIMIT=0
GROQ_TRANSLATION_LOCALES=

# -------------------------------------------------------------------------------------------
# CATELOGUE IMAGES DEFAULT TO PRIVATE LOCAL STORAGE; OPTIONAL PRIVATE S3-COMPATIBLE BACKEND
# -------------------------------------------------------------------------------------------
CATALOGUE_STORAGE_ALIAS=catalogue_local
# Set these only for catalogue_s3; preserve settings for previously stored objects when switching.
CATALOGUE_S3_BUCKET=
CATALOGUE_S3_ENDPOINT=
CATALOGUE_S3_REGION=us-east-1
CATALOGUE_S3_ACCESS_KEY=''
CATALOGUE_S3_SECRET_KEY=''
