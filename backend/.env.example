# Required private application secrets. Generate locally; never commit populated values.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-at-least-50-characters
MFA_ENCRYPTION_KEY=replace-with-a-separately-generated-fernet-key

# Development owner sign-in only. Production requires true; omission defaults to true.
OWNER_MFA_REQUIRED=false

# Application PostgreSQL connection. DATABASE_HOST maps localhost into Docker Desktop.
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/bazar_rezayi_db
DATABASE_HOST=host.docker.internal

# The Redis server and broker URL must use the same private password.
REDIS_PASSWORD=replace-with-a-generated-redis-password
CELERY_BROKER_URL=redis://:replace-with-a-generated-redis-password@redis:6379/0

# Trusted local application hosts/origins. Use approved HTTPS values in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:3100
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100

# Optional Google login: fill these private provider values only when enabling it.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8100/api/v1/auth/google/callback/

# Local capture sends no real mail. Production requires intentional SMTP configuration.
ACCOUNT_EMAIL_TRANSPORT=capture
# SMTP defaults: Gmail STARTTLS/587, TLS enabled, SSL disabled, 10-second timeout.
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
