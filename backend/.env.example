# Native development configuration. See doc/hosting/Native_Python_cPanel_Deployment.md
# for production origins, SMTP, private paths and provider prerequisites.
# Generate a signing key; preserve the original MFA key for existing encrypted records.
DJANGO_SECRET_KEY=replace-with-a-private-signing-key-at-least-50-characters
MFA_ENCRYPTION_KEY=replace-with-a-valid-private-fernet-key
OWNER_MFA_REQUIRED=true

# Explicit native PostgreSQL and authenticated Redis endpoints; no host override.
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/replace-database
CELERY_BROKER_URL=redis://:replace-password@127.0.0.1:6379/0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://127.0.0.1:3100
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100
# DATA_ROOT defaults to backend/data and PRIVATE_MAIL_ROOT to backend/data/private-mail.
# Keep these paths outside every public document root; configure privately when needed.

# Optional Google sign-in. Disabled until intended private credentials are configured.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8100/api/v1/auth/google/callback/

# Capture sends no mail. Production requires intentional SMTP configuration.
ACCOUNT_EMAIL_TRANSPORT=capture
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Optional Groq draft generation stays disabled pending approved account/model/languages/limits.
CATALOGUE_TRANSLATION_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_DAILY_CALL_LIMIT=0
GROQ_DAILY_CHARACTER_LIMIT=0
GROQ_TRANSLATION_LOCALES=

# Catalogue bytes remain private and are served through authorized application handlers.
CATALOGUE_STORAGE_ALIAS=catalogue_local
CATALOGUE_S3_BUCKET=
CATALOGUE_S3_ENDPOINT=
CATALOGUE_S3_REGION=us-east-1
CATALOGUE_S3_ACCESS_KEY=
CATALOGUE_S3_SECRET_KEY=

# Exact trusted HTTPS direct-media hosts; empty permits uploads and bundled hero only.
SITE_MEDIA_HOSTS=
