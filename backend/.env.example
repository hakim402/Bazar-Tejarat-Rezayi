DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/bazar_rezayi_db
DATABASE_HOST=host.docker.internal
DB_CONN_MAX_AGE=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
REDIS_PASSWORD=replace-with-local-redis-password
CELERY_BROKER_URL=redis://:replace-with-local-redis-password@redis:6379/0
BACKEND_PORT=8100
