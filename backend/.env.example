DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
POSTGRES_DB=rezayi_local
POSTGRES_USER=rezayi_local
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
REDIS_PASSWORD=replace-with-a-generated-local-password
CELERY_BROKER_URL=redis://:replace-with-the-local-redis-password@redis:6379/0
BACKEND_PORT=8100
