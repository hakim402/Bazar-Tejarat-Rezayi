msgid "Use {page} for the page title and {site} for the website name. Example: {page} | {site}."
msgstr "از {page} برای عنوان صفحه و {site} برای نام سایت استفاده کنید. مثال: {page} | {site}."

msgid "Used when a page is shared without its own image. PNG, JPEG or WebP; up to 8 MiB."
