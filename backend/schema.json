openapi: 3.0.3
info:
  title: Bazar Rezayi foundation API
  version: 1.0.0
paths:
  /api/v1/auth/{context}/link/{target}/:
    post:
      operationId: auth_link_create
      parameters:
      - in: path
        name: context
        schema:
          type: string
          pattern: ^buyer|seller$
        required: true
      - in: path
        name: target
        schema:
          type: string
          pattern: ^buyer|seller$
        required: true
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LinkRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LinkRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LinkRequestRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthResult'
          description: ''
  /api/v1/auth/{context}/logout/:
    post:
      operationId: auth_logout_create
      parameters:
      - in: path
        name: context
        schema:
          type: string
          pattern: ^buyer|seller|staff$
        required: true
      tags:
      - auth
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthResult'
          description: ''
  /api/v1/auth/{context}/mfa/reset/:
    post:
      operationId: auth_mfa_reset_create
      parameters:
      - in: path
        name: context
        schema:
          type: string
          pattern: ^staff|owner$
        required: true
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FactorResetRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/FactorResetRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FactorResetRequest'
        required: true
      security:
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuthResult'
          description: ''
  /api/v1/auth/{context}/password/:
    post:
      operationId: auth_password_create
      parameters:
      - in: path
        name: context
        schema:
          type: string
          pattern: ^buyer|seller|staff$
        required: true
