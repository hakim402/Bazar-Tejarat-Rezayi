{
    "openapi": "3.0.3",
    "info": {
        "title": "Bazar Rezayi foundation API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/bootstrap/": {
            "get": {
                "operationId": "bootstrap",
                "tags": [
                    "bootstrap"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Bootstrap"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "description": ""
                    },
                    "405": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "description": ""
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/health/live/": {
            "get": {
                "operationId": "liveness",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Status"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/health/ready/": {
            "get": {
                "operationId": "readiness",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Status"
                                }
                            }
                        },
                        "description": ""
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Status"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Bootstrap": {
                "type": "object",
                "properties": {
                    "default_locale": {
                        "$ref": "#/components/schemas/LocaleEnum"
                    },
                    "supported_locales": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LocaleEnum"
                        }
                    },
                    "brand_names": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    },
                    "currencies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CurrenciesEnum"
                        }
                    }
                },
                "required": [
                    "brand_names",
                    "currencies",
                    "default_locale",
                    "supported_locales"
                ]
            },
            "CurrenciesEnum": {
                "enum": [
                    "AFN",
                    "USD"
                ],
                "type": "string",
                "description": "* `AFN` - AFN\n* `USD` - USD"
            },
            "Error": {
                "type": "object",
                "properties": {
                    "error": {
                        "$ref": "#/components/schemas/ErrorBody"
                    }
                },
                "required": [
                    "error"
                ]
            },
            "ErrorBody": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "request_id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "fields": {}
                },
                "required": [
                    "code",
                    "message",
                    "request_id"
                ]
            },
            "LocaleEnum": {
                "enum": [
                    "fa-AF",
                    "en",
                    "ps",
                    "ar"
                ],
                "type": "string",
                "description": "* `fa-AF` - fa-AF\n* `en` - en\n* `ps` - ps\n* `ar` - ar"
            },
            "Status": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "alive",
                    "ready",
                    "not_ready"
                ],
                "type": "string",
                "description": "* `alive` - alive\n* `ready` - ready\n* `not_ready` - not_ready"
            }
        }
    }
}